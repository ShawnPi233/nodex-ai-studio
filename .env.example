# NodeX API
NODEX_PORT=4501
NODEX_DATA_DIR=./runs

# OpenCode runtime
# 留空则由 NodeX 自行探测 / 拉起（见 scripts/lib.sh）
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# 运行时工作目录：编码代理操作的项目根（留空则用当前工作目录）
OPENCODE_WORKDIR=
# OpenCode 监听端口（NODEX_OC_PORT 可覆盖，默认 4096）
NODEX_OC_PORT=4096
# 由 NodeX 拉起 OpenCode 时的模式：attach（共用，默认）/ isolated（隔离）
NODEX_OC_MODE=attach

# 默认模型（provider/model）；留空则使用 OpenCode 配置的默认模型
NODEX_DEFAULT_MODEL=

# 本地 AI（笔记本摘要等，OpenAI 兼容接口）；也可在界面「AI 设置」中配置
# NODEX_AI_BASE_URL=https://api.openai.com/v1
# NODEX_AI_API_KEY=
# NODEX_AI_MODEL=gpt-6-luna
